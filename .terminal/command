#!/usr/bin/env bash
set -u
echo "=== web foundation ==="
echo "host: $(hostname)"
echo "--- nginx package ---"
if command -v nginx >/dev/null 2>&1; then
  echo "nginx already installed"
else
  echo "NGINX_NOT_INSTALLED"
  echo "Run on oneslash manually:"
  echo "sudo apt update && sudo apt install -y nginx"
  echo "Then: sudo systemctl enable --now nginx"
  exit 0
fi
echo "--- nginx status ---"
sudo systemctl is-active nginx || true
echo "--- nginx version ---"
nginx -v 2>&1
echo "--- port 80/443 ---"
ss -lnt | grep -E ':(80|443) ' || true
