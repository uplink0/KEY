#!/usr/bin/env bash
set -u
echo "=== bridge diagnostics ==="
date -Is
echo "--- identity ---"
id
hostname
echo "--- listening ports ---"
sudo ss -lntp || ss -lntp
echo "--- docker ---"
docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
echo "--- firewall ---"
sudo ufw status 2>/dev/null || true
echo "--- nginx ---"
sudo systemctl is-active nginx 2>/dev/null || true
echo "--- DNS ---"
getent hosts terminal.atlas-infra.ru || true
echo "--- HTTP local probes ---"
curl -I --max-time 5 http://127.0.0.1/ 2>&1 || true
curl -kI --max-time 5 https://127.0.0.1/ 2>&1 || true
